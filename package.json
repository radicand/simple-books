{
  "name": "simple-books",
  "version": "0.1.15",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite dev --port 3000",
    "build": "NODE_ENV=production bun --bun vite build",
    "build:e2e": "REFERENCE_DATE=2026-05-18 bun run build",
    "start": "bun run .output/server/index.mjs",
    "db:generate": "bunx drizzle-kit generate --config=drizzle.config.sqlite.ts",
    "db:generate:pg": "bunx drizzle-kit generate --config=drizzle.config.pg.ts",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:seed": "bun run scripts/seed.ts",
    "db:reset": "rm -rf data/simple-books.db data/simple-books.db-shm data/simple-books.db-wal && bun run db:migrate && bun run db:seed",
    "auth:secret": "bun -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\"",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "bun run scripts/playwright-test.ts",
    "screenshots": "UPDATE_SCREENSHOTS=1 bun run test -- --grep @screenshots",
    "test:e2e": "bash scripts/e2e.sh",
    "test:e2e:quick": "bash scripts/e2e.sh --skip-build",
    "design:lint": "npx @google/design.md lint DESIGN.md"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@aws-sdk/s3-request-presigner": "^3.1140.0",
    "@better-auth/drizzle-adapter": "^1.7.6",
    "@libsql/client": "^0.18.0",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.39",
    "@tanstack/react-start": "^1.168.58",
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "overrides": {
    "undici": "7.29.1",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-devtools": "^1.167.2",
    "@types/bun": "^1.4.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "nitro": "^3.0.260903-beta",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
